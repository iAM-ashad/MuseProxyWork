<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for mic capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Optional but recommended declarations -->
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <!-- If the SDK uses USB host APIs, keep this. If it uses accessory mode, see note below. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".MuseApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MuseSample">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MuseSample">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- (Optional) Auto-launch when a matching USB device is attached.
                 Only add if you want plug-in-to-open behavior AND you know TAAL’s vendor/product IDs.
                 Otherwise omit this whole filter block. -->
            <!--
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
            -->
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

    </application>
</manifest>
